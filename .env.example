# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TRAX LINK Server & Security
PORT=3000
NETCO_MODE=STANDALONE_MODE
SQLITE_DB_PATH="./data/netco.db"
ROUTER_ENCRYPTION_KEY=""
ADMIN_INITIAL_PASSCODE=""

# PostgreSQL & Redis (for Docker / Production deployment)
DATABASE_URL="postgresql://traxlink:traxlink_password@localhost:5432/traxlink?schema=public"
REDIS_URL="redis://localhost:6379"

# FreeRADIUS & WireGuard Cloud Integration (Optional — MIKROTIK_MODE)
RADIUS_SHARED_SECRET=""
WIREGUARD_CLOUD_PUBKEY=""
WIREGUARD_ENDPOINT=""

# Mobile Money & Bank Card Provider Credentials (Tanzania)
# Leave blank if unconfigured; TRAX LINK marks providers as Integration Ready until configured.
MPESA_API_KEY=""
MPESA_PUBLIC_KEY=""
MPESA_SERVICE_PROVIDER_CODE=""
MPESA_WEBHOOK_SECRET=""

AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
AIRTEL_WEBHOOK_SECRET=""

TIGO_CLIENT_ID=""
TIGO_CLIENT_SECRET=""
TIGO_BILLER_CODE=""
TIGO_WEBHOOK_SECRET=""

HALOPESA_MERCHANT_CODE=""
HALOPESA_API_SECRET=""
HALOPESA_WEBHOOK_SECRET=""

CARD_GATEWAY_KEY=""
CARD_WEBHOOK_SECRET=""

